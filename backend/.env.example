# Copy to backend/.env and adjust. Never commit the real .env file.
#
# Local development values are shown below. For production use the hardened
# settings documented in ../docs/DEPLOYMENT.md: APP_ENV=production,
# FLASK_DEBUG=0, an explicit PostgreSQL DATABASE_URL, a strong JWT_SECRET_KEY,
# CORS_ALLOWED_ORIGINS for your frontend domain and
# REGISTRATION_ALLOWED_ROLES=retailer.

# Flask / deployment profile
APP_ENV=development
FLASK_ENV=development
FLASK_APP=run.py
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000

# PostgreSQL connection string.
# SQLAlchemy accepts postgresql://... (psycopg2 is installed).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mediflow

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Production startup rejects placeholders, weak values and the dev default.
JWT_SECRET_KEY=replace-with-a-long-random-value
SECRET_KEY=

# Token lifetime (hours)
JWT_ACCESS_TOKEN_HOURS=12

# Comma separated list of allowed browser origins.
# CORS_ALLOWED_ORIGINS is the documented name; CORS_ORIGINS is accepted as an
# alias for older local scripts.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8080,http://127.0.0.1:8080

# Comma separated roles a user may self-select when registering.
# Demo parity allows all three locally; use "retailer" for a locked-down
# deployment (production validation rejects privileged self-registration).
REGISTRATION_ALLOWED_ROLES=admin,distributor,retailer

# Logging: INFO/DEBUG/WARNING/ERROR; text for local, json for production.
LOG_LEVEL=INFO
LOG_FORMAT=text

# ---------------------------------------------------------------------------
# AI assistant (optional)
# ---------------------------------------------------------------------------
# Provider: openai (also use this for OpenAI-compatible gateways),
# openai-compatible, or ollama for a local model.
# The API key is backend-only; it is never exposed to the browser bundle.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Optional endpoint override, e.g. https://api.openai.com/v1
# LLM_BASE_URL=https://api.openai.com/v1
#
# Local Ollama example:
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama3.1:8b
#   LLM_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT=30
LLM_MAX_TOKENS=800
# Bounded context window for Ollama (larger values use more RAM on CPU hosts).
LLM_NUM_CTX=8192

# Assistant safety and cost limits (defaults shown).
AI_MAX_MESSAGE_LENGTH=2000
AI_MAX_HISTORY_MESSAGES=6
AI_MAX_HISTORY_MESSAGE_CHARS=2000
AI_MAX_TOOL_ITERATIONS=4
AI_MAX_TOOL_CALLS_PER_TURN=6
AI_MAX_TOOL_RESULT_CHARS=4000
AI_MAX_ANSWER_CHARS=8000
# Streaming streams the final answer over SSE while tools stay bounded.
AI_ENABLE_STREAMING=true
AI_STREAM_MAX_CHUNKS=4000
AI_RATE_LIMIT_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=300
