# Copy to backend/.env and adjust. Never commit the real .env file.

# Flask
FLASK_ENV=development
FLASK_APP=run.py
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000

# PostgreSQL connection string.
# SQLAlchemy accepts postgresql://... (psycopg2 is installed).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mediflow

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-value

# Token lifetime (hours)
JWT_ACCESS_TOKEN_HOURS=12

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Comma separated roles a user may self-select when registering.
# Demo parity allows all three; restrict to "retailer" for a locked-down deployment.
REGISTRATION_ALLOWED_ROLES=admin,distributor,retailer
