# Copy this file to `.env` and adjust for your environment. Never commit `.env`.
#
# This single file is used by:
#   - Vite (`VITE_*` variables) for local frontend development
#   - Docker Compose for the backend/database container configuration
#
# Only VITE_* variables are exposed to the built browser bundle. Never put a
# database URL, JWT secret or any backend credential in a VITE_* variable.

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
# Base URL of the Flask REST API (no trailing slash).
# Local development: http://localhost:5000/api
# Docker Compose: /api (nginx proxies to the backend service)
VITE_API_BASE_URL=http://localhost:5000/api

# "true"  -> resolve every service call from the local mock data layer
#            (src/data/mockData.js); no network requests are made.
# "false" -> call the Flask API at VITE_API_BASE_URL (live integration mode).
# Production/Docker Compose forces "false" at build time.
VITE_USE_MOCK_API=true

# ---------------------------------------------------------------------------
# Docker Compose / backend secrets
# ---------------------------------------------------------------------------
# Required by `docker compose up`. Generate strong values, for example:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leave these blank in version control. Compose refuses to start when empty.
POSTGRES_DB=mediflow
POSTGRES_USER=mediflow
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
# Optional: falls back to JWT_SECRET_KEY when blank. Use a different value in
# production if you want independent Flask-session and JWT keys.
SECRET_KEY=

JWT_ACCESS_TOKEN_HOURS=12

# Comma separated browser origins allowed to call the API directly.
# Docker Compose serves the UI on http://localhost:8080 (same-origin proxy), so
# CORS is usually unnecessary there. Add real frontend URLs when split-hosting.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Comma separated roles a user may self-select when registering.
# Production should only allow "retailer"; privileged roles are provisioned by
# an administrator via `flask --app run.py create-admin`.
REGISTRATION_ALLOWED_ROLES=retailer

# ---------------------------------------------------------------------------
# AI assistant (optional; consumed by the backend container only)
# ---------------------------------------------------------------------------
# Provider: openai (or an OpenAI-compatible gateway), openai-compatible, or ollama.
# The key is backend-only and never included in the VITE_* browser bundle.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Optional endpoint override, e.g. https://api.openai.com/v1
# LLM_BASE_URL=
#
# Local Ollama (run Ollama on the host and expose it to the container):
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama3.1:8b
#   LLM_BASE_URL=http://host.docker.internal:11434
LLM_TIMEOUT=30
LLM_MAX_TOKENS=800
AI_RATE_LIMIT_REQUESTS=20
AI_RATE_LIMIT_WINDOW_SECONDS=300

# Container ports on the host (optional overrides).
FRONTEND_PORT=8080
BACKEND_PORT=5000
